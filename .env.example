# =============================================================================
# NEXVORA — ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy to `.env` and fill in real values. `.env*` is gitignored (except this file).
#
# This project FAILS CLOSED on credentials: there are no fallback literals in
# source. If a variable below is unset, the feature that needs it refuses to run
# and says which variable is missing. That is deliberate — a hardcoded fallback
# key is a key committed to git, and on the order path a wrong key is worse than
# no key.
#
# NEVER commit real values. See SECURITY-ROTATION.md if a secret has leaked.
# =============================================================================

# --- Angel One SmartAPI (BROKER — MOVES REAL MONEY) -------------------------
# From https://smartapi.angelbroking.com/ -> My Apps.
# ANGEL_ONE_API_KEY is required for quotes, historical candles, the market-data
# websocket, AND live order placement. There is no fallback.
ANGEL_ONE_API_KEY=""

# Your broker login. Treat the TOTP secret as the most sensitive value here: it
# does not expire, so a leak is permanent until you reset 2FA in the Angel One app.
ANGEL_ONE_CLIENT_CODE=""
ANGEL_ONE_MPIN=""
ANGEL_ONE_TOTP_SECRET=""

# --- LLM providers ----------------------------------------------------------
# Gemini — market research synthesis and the analyst chat.
GEMINI_API_KEY=""

# OpenCode / Nemtron. If unset, the Nemtron layer reports itself UNAVAILABLE
# rather than fabricating a directional call.
OPENCODE_API_KEY=""
OPENCODE_API_BASE_URL="https://opencode.ai/zen/v1"
OPENCODE_MODEL_NAME="nemtron-3-ultra"

# NVIDIA NIM — fallback LLM provider.
NVIDIA_API_KEY=""
NVIDIA_API_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL_NAME="minimaxai/minimax-m2.7"

# --- Delta Exchange (crypto derivatives) ------------------------------------
DELTA_EXCHANGE_API_KEY=""
DELTA_EXCHANGE_API_SECRET=""

# --- Supabase (media upload for CRM/outreach) -------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Lead generation / automation -------------------------------------------
BROWSERLESS_API_KEY=""
GOOGLE_MAPS_API_KEY=""
CRM_BASE_URL=""

# --- App ---------------------------------------------------------------------
APP_URL=""
PORT="3000"
